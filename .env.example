# Variáveis públicas do Firebase (sem segredos — seguro commitar)
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Firebase.
# Em produção, configure as mesmas variáveis no painel do Cloudflare Pages.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulador local — deixe em branco em produção
# VITE_USE_EMULATOR=true
