rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    // Retorna true se o usuário está autenticado e tem ativo: true
    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    // Retorna o perfil do usuário autenticado
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    // Retorna true se o usuário autenticado é admin
    function isAdmin() {
      return isActiveUser() && perfil() == 'admin';
    }

    // ─── usuarios ─────────────────────────────────────────────────────────────
    // Leitura: qualquer usuário ativo pode ler seu próprio documento.
    // Admins podem ler qualquer documento de usuário.
    // Escrita: só admin pode criar/atualizar usuários.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── dominios (lista de domínios) ─────────────────────────────────────────
    // Leitura: qualquer usuário ativo (o formulário precisa carregar as listas).
    // Criação: qualquer usuário ativo pode adicionar itens na lista direto pelo formulário.
    // Atualização/Exclusão: apenas admin.
    match /dominios/{dominioId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();

      // ─── dominios/{chave}/itens ─────────────────────────────────────────────
      match /itens/{itemId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser();
        allow update, delete: if isAdmin();
      }
    }

    // ─── registros ────────────────────────────────────────────────────────────
    // Leitura: qualquer usuário ativo.
    // Criação: usuário ativo, criadoPor deve ser o próprio uid, data não pode
    //          ser futura (comparada com request.time).
    // Atualização: usuário ativo. Não pode alterar criadoPor.
    // Exclusão: usuário ativo (qualquer um pode excluir; restrição adicional
    //           pode ser feita na Fase 2 se necessário).
    match /registros/{registroId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.data <= request.time;

      allow update: if isActiveUser()
        && request.resource.data.criadoPor == resource.data.criadoPor;

      allow delete: if isActiveUser();
    }
  }
}
